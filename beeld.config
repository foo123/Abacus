###################################################
#
#   The buildtools repository is at:
#   https://github.com/foo123/Beeld
#
###################################################

settings ={}
    Xpresion = "Xpresion::"
    RegExp = "RegExp::"
@

plugins =[{}]
    "minify" = "!plg:minify"
    #"doc" = "!plg:doc"
@

tasks =[{}]

    build =[{}]

        src =[]
            ### Abacus.js ###
            ./src/header.js

            # utilities
            ./src/utilities/utils.js
            ./src/utilities/math.js
            ./src/utilities/Node.js
            ./src/utilities/ListSet.js
            ./src/utilities/BitArray.js
            ./src/utilities/Counters.js
            ./src/utilities/Heap.js

            # Symbolic Computation
            ./src/symbolic/INumber.js
            ./src/symbolic/Integer.js
            ./src/symbolic/Rational.js
            ./src/symbolic/Complex.js
            ./src/symbolic/Expr.js
            ./src/symbolic/Polynomial.js
            ./src/symbolic/RationalFunc.js
            ./src/symbolic/Series.js
            ./src/symbolic/Matrix.js
            ./src/symbolic/Ring.js

            # Combinatorics
            ./src/combinatorics/Order.js
            ./src/combinatorics/CombinatorialIterator.js
            ./src/combinatorics/Filter.js
            ./src/combinatorics/Progression.js
            ./src/combinatorics/PrimeSieve.js
            ./src/combinatorics/Tensor.js
            ./src/combinatorics/Permutation.js
            ./src/combinatorics/Combination.js
            ./src/combinatorics/Subset.js
            ./src/combinatorics/Partition.js
            ./src/combinatorics/SetPartition.js
            ./src/combinatorics/DyckWord.js
            ./src/combinatorics/MagicSquare.js

            ./src/footer.js
        @

        # extract header from this file
        header = ./src/header.js

        replace =[{}]
            "@@VERSION@@" = "2.0.0"
            "@@DATE@@" = Xpresion::date("Y-m-d H:i:s")
        @

        # extract documentation
        #doc ={}
        #    "startdoc" = "/**[DOC_MD]"
        #    "enddoc" = "[/DOC_MD]**/"
        #    "trim" = RegExp::^\s*\*[ ]?
        #    "output" = "./manual.md"
        #@

        out = ./build/Abacus.js
    @

    minify =[{}]

        src =[]
            ./build/Abacus.js
        @

        # Minify the Package (map of lists)
        minify ={}
            # Options for Node UglifyJS Compiler (if used, default), (mangle and compress)
            uglifyjs =[]
                -m -c
            @
        @

        out = ./build/Abacus.min.js
    @
@
